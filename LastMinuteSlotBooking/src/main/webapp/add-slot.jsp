<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Add New Slot</title><style>
*{box-sizing:border-box}body{margin:0;font-family:Segoe UI,Arial;background:#f4f8fc;color:#14213d}.nav{height:68px;background:#071d3d;color:#fff;padding:0 7%;display:flex;align-items:center;justify-content:space-between}.nav a{color:#fff;text-decoration:none;margin-left:18px}.box{max-width:700px;margin:45px auto;background:#fff;padding:32px;border-radius:18px;box-shadow:0 12px 35px #0f172a12}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}h1{margin-top:0}label{font-size:13px;font-weight:700;color:#475569}input{width:100%;padding:12px;margin-top:6px;border:1px solid #cbd5e1;border-radius:9px}.btn{grid-column:1/-1;border:0;background:#0b9b58;color:#fff;padding:13px;border-radius:9px;font-weight:700;cursor:pointer;font-size:15px}.error{background:#fee2e2;color:#991b1b;padding:11px;border-radius:8px;margin-bottom:15px}@media(max-width:650px){.grid{grid-template-columns:1fr}.btn{grid-column:auto}}
</style></head><body><nav class="nav"><b>Last Minute Slot Booking</b><div><a href="admin">Dashboard</a><a href="logout">Logout</a></div></nav><div class="box"><h1>Add New Slot</h1><p style="color:#64748b">Create a new bookable time slot for users.</p><%if("1".equals(request.getParameter("error"))){%><div class="error">Please check all values. Date/time must be in the future.</div><%}%><form action="add-slot" method="post" enctype="multipart/form-data"><div class="grid"><div><label>Event Name</label><input type="text" name="eventName" placeholder="Cricket Ground" required></div><div><label>Location</label><input type="text" name="location" placeholder="Pune" required></div><div><label>Date & Time</label><input type="datetime-local" name="slotTime" required></div><div><label>Duration (minutes)</label><input type="number" name="duration" min="1" max="1440" value="60" required></div><div><label>Price (₹)</label><input type="number" name="price" min="0" step="0.01" value="500" required></div><div style="grid-column:1/-1"><label>Slot Image (optional)</label><input type="file" name="imageFile" accept="image/jpeg,image/png,image/gif,image/webp" onchange="previewImage(event)"><small>Upload JPG, PNG, GIF or WEBP. Maximum 2 MB.</small><img id="preview" style="display:none;width:100%;max-height:220px;object-fit:cover;border-radius:12px;margin-top:12px" alt="Preview"></div>
<div style="grid-column:1/-1"><label>Or Image URL (optional)</label><input type="url" name="imageUrl" placeholder="https://example.com/cricket-ground.jpg"><small>Use this only if you don't want to upload a local image.</small></div><button class="btn" type="submit">＋ Add Slot</button></div></form></div><script>function setMinDateTime(){const x=document.querySelector("input[name=slotTime]");if(x){const d=new Date(Date.now()+60000);const z=n=>String(n).padStart(2,"0");x.min=d.getFullYear()+"-"+z(d.getMonth()+1)+"-"+z(d.getDate())+"T"+z(d.getHours())+":"+z(d.getMinutes());}}window.addEventListener("load",setMinDateTime);</script><script>function previewImage(e){const f=e.target.files[0],p=document.getElementById('preview');if(!f){p.style.display='none';return;}p.src=URL.createObjectURL(f);p.style.display='block';}</script></body></html>
