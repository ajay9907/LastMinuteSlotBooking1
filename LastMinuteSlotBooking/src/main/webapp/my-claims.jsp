<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="java.util.List,com.lastminuteslotbooking.model.Claim,com.lastminuteslotbooking.model.Slot,com.lastminuteslotbooking.service.SlotService"%>
<% if(session.getAttribute("user")==null){response.sendRedirect("login.jsp");return;} List<Claim> claims=(List<Claim>)request.getAttribute("claims"); SlotService ss=new SlotService(); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My Claims</title><style>
*{box-sizing:border-box}body{margin:0;font-family:Segoe UI,Arial;background:#f5f8fc;color:#10203a}.nav{height:68px;background:#071d3d;color:#fff;padding:0 7%;display:flex;justify-content:space-between;align-items:center}.nav a{color:#fff;text-decoration:none;margin-left:18px}.wrap{width:90%;max-width:1050px;margin:40px auto}.head{margin-bottom:22px}.head h1{margin:0}.head p{color:#64748b}.card{background:#fff;border:1px solid #e2e8f0;border-radius:15px;padding:20px;margin-bottom:15px;box-shadow:0 6px 22px #0f172a0a;display:grid;grid-template-columns:1fr auto;gap:20px}.meta{display:grid;gap:7px;color:#64748b;font-size:14px}.meta h2{color:#10203a;margin:0 0 4px}.badge{display:inline-block;padding:6px 10px;border-radius:20px;font-size:12px;font-weight:700}.active{background:#dcfce7;color:#166534}.cancel{background:#fee2e2;color:#991b1b}.btn{background:#ef3340;color:#fff;border:0;border-radius:8px;padding:10px 14px;font-weight:700;cursor:pointer}.empty{text-align:center;background:#fff;padding:50px;border-radius:15px;border:1px solid #e2e8f0}.primary{display:inline-block;background:#1268da;color:#fff;text-decoration:none;padding:11px 17px;border-radius:8px;font-weight:700;margin-top:10px}@media(max-width:650px){.card{grid-template-columns:1fr}.nav a{margin-left:8px}}
</style></head><body><nav class="nav"><b>Last Minute Slot Booking</b><div><a href="slots">Browse Slots</a><a href="role.jsp">Dashboard</a><a href="logout">Logout</a></div></nav><main class="wrap"><div class="head"><h1>My Claims</h1><p>Track your current and cancelled bookings.</p></div><%if(claims==null||claims.isEmpty()){%><div class="empty"><div style="font-size:45px">🎟️</div><h2>No bookings yet</h2><p>Choose an available slot to create your first booking.</p><a class="primary" href="slots">Browse Available Slots</a></div><%}else{for(Claim c:claims){Slot s=ss.getSlotById(c.getSlotId());%><div class="card"><div class="meta"><h2><%=s==null?"Slot #"+c.getSlotId():s.getEventName()%></h2><div>📍 <%=s==null?"-":s.getLocation()%></div><div>🗓️ <%=s==null?"-":s.getSlotTime().toString().replace('T',' ')%></div><div>💰 <%=s==null?"-":"₹ "+String.format("%.2f",s.getPrice())%></div><div>Claim ID: #<%=c.getId()%> · Claimed: <%=c.getClaimedAt()==null?"-":c.getClaimedAt().toString().replace('T',' ')%></div></div><div style="text-align:right"><span class="badge <%=c.getStatus().equalsIgnoreCase("CLAIMED")?"active":"cancel"%>"><%=c.getStatus()%></span><%if("CLAIMED".equalsIgnoreCase(c.getStatus())){%><form action="cancel" method="post" onsubmit="return confirm('Cancel this booking?');" style="margin-top:18px"><input type="hidden" name="claimId" value="<%=c.getId()%>"><button class="btn">Cancel Booking</button></form><%}%></div></div><%}}%></main></body></html>
