<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="com.lastminuteslotbooking.model.User"%>
<% User user=(User)session.getAttribute("user"); if(user==null){response.sendRedirect("login.jsp");return;} boolean admin="ADMIN".equalsIgnoreCase(user.getRole()); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Choose Your Role</title><style>
*{box-sizing:border-box}body{margin:0;font-family:Segoe UI,Arial;background:linear-gradient(135deg,#eef6ff,#fff);color:#13213b}.nav{height:68px;background:#061d3d;color:#fff;padding:0 6%;display:flex;justify-content:space-between;align-items:center}.nav a{color:#fff;text-decoration:none;margin-left:20px}.wrap{min-height:calc(100vh - 68px);display:flex;align-items:center;justify-content:center;padding:35px}.box{width:900px;max-width:100%;text-align:center}.box h1{font-size:36px;margin-bottom:8px}.sub{color:#64748b;margin-bottom:30px}.cards{display:grid;grid-template-columns:1fr <%=admin?"1fr":"0fr"%>;gap:22px}.card{background:#fff;border:1px solid #dbe4ef;border-radius:18px;padding:35px 25px;box-shadow:0 12px 35px #0f172a10}.card:hover{transform:translateY(-4px)}.icon{font-size:55px}.card h2{margin:12px 0 8px}.card p{color:#64748b;min-height:45px}.btn{display:inline-block;padding:12px 28px;border-radius:9px;text-decoration:none;color:#fff;background:#1268da;font-weight:700}.admin .btn{background:#f59e0b;color:#1f2937}@media(max-width:650px){.cards{grid-template-columns:1fr}}
</style></head><body><nav class="nav"><b>Last Minute Slot Booking</b><div><span>Hi, <%=user.getName()%></span> <a href="logout">Logout</a></div></nav><main class="wrap"><div class="box"><div style="font-size:42px">🎯</div><h1>Choose Your Role</h1><p class="sub">Select the dashboard you want to continue to.</p><div class="cards"><div class="card"><div class="icon">👤</div><h2>User</h2><p>Browse available slots, search by event/location, book a slot and manage your claims.</p><a class="btn" href="slots">Continue as User</a></div><%if(admin){%><div class="card admin"><div class="icon">👑</div><h2>Admin</h2><p>Create, edit and delete slots, monitor availability and review recent claims.</p><a class="btn" href="admin">Open Admin Dashboard</a></div><%}%></div></div></main></body></html>
