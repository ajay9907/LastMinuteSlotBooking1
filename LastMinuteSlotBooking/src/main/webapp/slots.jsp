<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ page import="java.util.List,com.lastminuteslotbooking.model.Slot"%>
<% if(session.getAttribute("user")==null){response.sendRedirect("login.jsp");return;} List<Slot> slots=(List<Slot>)request.getAttribute("slots"); String keyword=(String)request.getAttribute("keyword"); String location=(String)request.getAttribute("location"); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Available Slots</title><style>
*{box-sizing:border-box}body{margin:0;font-family:Segoe UI,Arial;background:#f5f8fc;color:#10203a}.nav{height:68px;background:#071d3d;color:white;padding:0 6%;display:flex;align-items:center;justify-content:space-between}.brand{font-size:21px;font-weight:800}.brand span{color:#38bdf8}.nav a{color:#fff;text-decoration:none;margin-left:18px;font-size:14px}.logout{border:1px solid #5c7294;padding:8px 12px;border-radius:7px}.head{text-align:center;padding:38px 15px 20px}.head h1{margin:0;font-size:34px}.head p{color:#64748b}.search{width:90%;max-width:1050px;margin:0 auto 30px;background:#fff;padding:16px;border:1px solid #e2e8f0;border-radius:14px;display:grid;grid-template-columns:1.4fr 1fr auto;gap:10px}.search input{padding:12px;border:1px solid #cbd5e1;border-radius:8px}.btn{border:0;background:#1268da;color:#fff;border-radius:8px;padding:12px 18px;font-weight:700;cursor:pointer}.grid{width:90%;max-width:1250px;margin:auto auto 45px;display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{background:#fff;border:1px solid #e2e8f0;border-radius:16px;padding:20px;box-shadow:0 8px 25px #0f172a0b}.top{display:flex;justify-content:space-between;gap:10px}.badge{background:#dcfce7;color:#166534;padding:6px 10px;border-radius:20px;font-size:12px;font-weight:700;height:max-content}.card h2{margin:15px 0 5px}.location{color:#64748b}.info{display:grid;gap:9px;margin:18px 0;color:#475569;font-size:14px}.price{font-size:22px;font-weight:800;color:#1268da}.bottom{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #edf1f5;padding-top:16px}.claim{background:#1268da;color:#fff;border:0;padding:10px 16px;border-radius:8px;font-weight:700;cursor:pointer}.empty{width:90%;max-width:600px;margin:40px auto;background:white;padding:40px;text-align:center;border-radius:15px;border:1px solid #e2e8f0;color:#64748b}@media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.search{grid-template-columns:1fr}.grid{grid-template-columns:1fr}.nav a{margin-left:8px}}
</style></head><body><nav class="nav"><div class="brand">Last Minute <span>Slot Booking</span></div><div><a href="my-claims">My Claims</a><a href="role.jsp">Dashboard</a><a class="logout" href="logout">Logout</a></div></nav><header class="head"><h1>Available <span style="color:#1268da">Slots</span></h1><p>Find a nearby slot and reserve it in seconds.</p></header>
<form class="search" action="slots" method="get"><input name="keyword" value="<%=keyword%>" placeholder="Search event e.g. Cricket, Badminton"><input name="location" value="<%=location%>" placeholder="Location e.g. Pune"><button class="btn">🔎 Search</button></form>
<%if(slots==null||slots.isEmpty()){%><div class="empty"><div style="font-size:45px">📅</div><h2>No slots found</h2><p>Try another event or location, or check again later.</p><a class="btn" href="slots" style="display:inline-block;text-decoration:none">Clear Search</a></div><%}else{%><main class="grid"><%for(Slot s:slots){%><article class="card"><% if(s.getImageData()!=null && s.getImageData().length>0){ %><img loading="lazy" alt="Slot image" style="width:100%;height:185px;object-fit:cover;border-radius:12px;margin-bottom:12px" src="slot-image?id=<%=s.getId()%>"><% } else if(s.getImageUrl()!=null && s.getImageUrl().matches("https?://[^\"<> ]+")){ %><img loading="lazy" alt="Slot image" style="width:100%;height:185px;object-fit:cover;border-radius:12px;margin-bottom:12px" src="<%=s.getImageUrl().replace("&","&amp;")%>" onerror="this.style.display='none'"/><% } %><div class="top"><span style="font-size:28px">🎟️</span><span class="badge">Available</span></div><h2><%=s.getEventName()%></h2><div class="location">📍 <%=s.getLocation()%></div><div class="info"><div>🗓️ <%=s.getSlotTime().toString().replace('T',' ')%></div><div>⏱️ <%=s.getDuration()%> minutes</div><div>💰 ₹ <%=String.format("%.2f",s.getPrice())%></div></div><div class="bottom"><span class="price">₹ <%=String.format("%.0f",s.getPrice())%></span><form action="claim" method="post" onsubmit="return confirm('Claim this slot?');"><input type="hidden" name="slotId" value="<%=s.getId()%>"><button class="claim">Claim Slot</button></form></div></article><%}%></main><%}%></body></html>
